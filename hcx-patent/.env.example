# HCX-Patent Configuration
# Copy this file to .env and adjust values as needed

# Dataset location (path to directory containing parquet files)
DATASET_ROOT=D:\ALT-PROJECT\DATA

# Project root directory
PROJECT_ROOT=D:\ALT-PROJECT\hcx-patent

# Server settings
DEBUG=true
HOST=127.0.0.1
PORT=8000

# Device: cpu or cuda
DEVICE=cpu

# Development sample size (use subset for quick experiments)
DEV_SAMPLE_SIZE=10000

# Random seed for reproducibility
RANDOM_SEED=42

# Batch size for training
BATCH_SIZE=64

# Max text length for transformer models (tokens)
MAX_TEXT_LENGTH=512

